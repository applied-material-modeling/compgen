            "poissons_ratio": {"dist": "uniform", "range": [0.01, 0.49]},
            "density": {"dist": "uniform", "range": [0.5, 23.0]},
            "l": {"fixed": 0.015},
            "Gc": {"dist": "loguniform", "range": [0.005, 300.0]},
            "psic": {"dist": "loguniform", "range": [0.5, 300.0]}
        }
    },
    "material_B": {
        "type": "materials.DistributionMaterialGenerator",
        "params": {
            "youngs_modulus": {"dist": "uniform", "range": [1000.0, 500000.0]},
            "poissons_ratio": {"dist": "uniform", "range": [0.01, 0.49]},
            "density": {"dist": "uniform", "range": [0.5, 23.0]},
            "l": {"fixed": 0.015},
            "Gc": {"dist": "loguniform", "range": [0.005, 300.0]},
            "psic": {"dist": "loguniform", "range": [0.5, 300.0]}
