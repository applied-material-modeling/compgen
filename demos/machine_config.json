{
    "sculpt": {
        "executable": "${CUBIT_DIR}/bin/psculpt",
        "mpi": "${CUBIT_DIR}/bin/mpiexec",
        "rank_command": "-np",
        "epu": "${CUBIT_DIR}/bin/epu",
        "environment": {
            "OPAL_LIBDIR": "${CUBIT_DIR}/bin/mpi/lib",
            "OPAL_PREFIX": "${CUBIT_DIR}/bin/mpi"
        },
        "options": [
            "-p",
            "1",
            "--smooth",
            "8",
            "--csmooth",
            "5"
        ]
    },
    "moose": {
        "executable": "${MOOSE_DIR}/modules/solid_mechanics/solid_mechanics-opt",
        "options": []
    },
    "mpi": {
        "executable": "mpirun",
        "rank_command": "-np",
        "ranks": "4"
    },
    "storage": {
        "delete_temp_dir": true
    },
    "verbose": false
}